# Zmienne środowiskowe (skopiuj do .env.local i uzupełnij). Bez nich aplikacja działa, z wyjątkami poniżej.

# Czat ZuSik (Claude API). Bez klucza przycisk czatu się nie pokazuje.
ANTHROPIC_API_KEY=
# Limity pytań do ZuSika
ZUSIK_LIMIT_NA_GODZINE=60
ZUSIK_LIMIT_NA_DOBE=500

# Hasło do zapisu parametrów w panelu /admin. Bez niego zapis jest zawsze odrzucany (odczyt działa).
ADMIN_HASLO=

# Gdzie panel admina zapisuje parametry: plik (lokalnie) albo pamiec (hosting bezserwerowy).
MAGAZYN_PARAMETROW=plik
MAGAZYN_PARAMETROW_PLIK=.data/parametry.json
